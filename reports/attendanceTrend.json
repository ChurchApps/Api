{
  "keyName": "attendanceTrend",
  "displayName": "Attendance Trend",
  "description": "Total counts of how many people attended each week.",
  "queries": [
    {
      "depth": 0,
      "keyName": "groups",
      "db": "membership",
      "sqlLines": [
        "SELECT id from `groups` WHERE churchId=:churchId AND removed=0 AND trackAttendance=1 AND id=COALESCE(NULLIF(:groupId,''), id)"
      ]
    },
    {
      "depth": 1,
      "keyName": "main",
      "db": "attendance",
      "sqlLines": [
        "SELECT STR_TO_DATE(concat(year(v.visitDate), ' ', week(v.visitDate, 0), ' Sunday'), '%X %V %W') AS week, count(distinct(v.id)) as visits, GROUP_CONCAT(DISTINCT DATE_FORMAT(v.visitDate, '%c/%e') ORDER BY DATE_FORMAT(v.visitDate, '%Y-%m-%d') SEPARATOR ', ') AS sessionDates",
        "FROM visits v",
        "LEFT JOIN visitSessions vs on vs.visitId=v.id",
        "LEFT JOIN sessions s on s.id = vs.sessionId",
        "LEFT JOIN groupServiceTimes gst on gst.groupId = s.groupId",
        "LEFT JOIN serviceTimes st on st.id = gst.serviceTimeId",
        "LEFT JOIN services ser on ser.id = st.serviceId",
        "WHERE v.churchId=:churchId",
        "AND (:groupId='' OR s.groupId IN (:groupIds))",
        "AND (:serviceTimeId='' OR st.id = :serviceTimeId)",
        "AND (:serviceId='' OR ser.id = :serviceId)",
        "AND (:campusId='' OR ser.campusId = :campusId)",
        "AND v.visitDate >= :startDate AND v.visitDate < DATE_ADD(:endDate, INTERVAL 1 DAY)",
        "GROUP BY year(v.visitDate), week(v.visitDate, 0), STR_TO_DATE(concat(year(v.visitDate), ' ', week(v.visitDate, 0), ' Sunday'), '%X %V %W')",
        "ORDER BY year(v.visitDate), week(v.visitDate, 0);"
      ]
    }
  ],
  "parameters": [
    {
      "keyName": "churchId",
      "source": "au",
      "sourceKey": "churchId"
    },
    {
      "keyName": "campusId",
      "displayName": "Campus",
      "source": "dropdown",
      "sourceKey": "campus"
    },
    {
      "keyName": "serviceId",
      "displayName": "Service",
      "source": "dropdown",
      "sourceKey": "service"
    },
    {
      "keyName": "serviceTimeId",
      "displayName": "Service Time",
      "source": "dropdown",
      "sourceKey": "serviceTime"
    },
    {
      "keyName": "groupId",
      "displayName": "Group",
      "source": "dropdown",
      "sourceKey": "group"
    },
    {
      "keyName": "startDate",
      "displayName": "Start Date",
      "source": "date",
      "sourceKey": "startDate",
      "defaultValue": "lastYear"
    },
    {
      "keyName": "endDate",
      "displayName": "End Date",
      "source": "date",
      "sourceKey": "endDate",
      "defaultValue": "today"
    },
    {
      "keyName": "groupIds",
      "source": "query",
      "sourceKey": "groups.id"
    }
  ],
  "outputs": [
    {
      "outputType": "barChart",
      "columns": [
        {
          "header": "Week",
          "value": "week",
          "formatter": "date"
        },
        {
          "header": "Visits",
          "value": "visits",
          "formatter": "number"
        }
      ]
    },
    {
      "outputType": "table",
      "columns": [
        {
          "header": "Week",
          "value": "week",
          "formatter": "date"
        },
        {
          "header": "Visits",
          "value": "visits",
          "formatter": "number"
        },
        {
          "header": "Session Dates",
          "value": "sessionDates",
          "formatter": "string"
        }
      ]
    }
  ],
  "permissions": [
    {
      "requireOne": [
        {
          "api": "AttendanceApi",
          "contentType": "Attendance",
          "action": "View"
        }
      ]
    }
  ]
}