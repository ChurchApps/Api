{
  "keyName": "groupAttendance",
  "displayName": "Group Attendance",
  "description": "Total counts of how many people attended each week.",
  "queries": [
    {
      "depth": 0,
      "keyName": "main",
      "db": "attendance",
      "sqlLines": [
        "SELECT DATE_FORMAT(s.sessionDate, '%Y-%m-%d') as sessionDate, ser.name as serviceName, st.name as serviceTimeName, s.groupId, v.personId, v.checkinTime",
        " FROM visits v",
        " INNER JOIN visitSessions vs on vs.churchId=v.churchId AND vs.visitId=v.id",
        " INNER JOIN sessions s on s.id=vs.sessionId",
        " INNER JOIN serviceTimes st on st.id=s.serviceTimeId",
        " INNER JOIN services ser on ser.id=st.serviceId",
        " WHERE v.churchId=:churchId",
        " AND (:serviceId IN ('', '0') OR ser.id = :serviceId) ",
        " AND s.sessionDate >= :startDate AND s.sessionDate < DATE_ADD(:endDate, INTERVAL 1 DAY)",
        " ORDER BY s.sessionDate, ser.name, st.name"
      ]
    },
    {
      "depth": 1,
      "keyName": "people",
      "db": "membership",
      "sqlLines": [
        "SELECT id, displayName, membershipStatus from people where churchId=:churchId and id in (:peopleIds)"
      ],
      "joinConditions": [
        {
          "parent": "personId",
          "child": "id"
        }
      ]
    },
    {
      "depth": 1,
      "keyName": "groups",
      "db": "membership",
      "sqlLines": [
        "SELECT id, name as groupName from `groups` where churchId=:churchId"
      ],
      "joinConditions": [
        {
          "parent": "groupId",
          "child": "id"
        }
      ]
    }
  ],
  "parameters": [
    {
      "keyName": "churchId",
      "source": "au",
      "sourceKey": "churchId"
    },
    {
      "keyName": "campusId",
      "displayName": "Campus",
      "source": "dropdown",
      "sourceKey": "campus"
    },
    {
      "keyName": "serviceId",
      "displayName": "Service",
      "source": "dropdown",
      "sourceKey": "service"
    },
    {
      "keyName": "startDate",
      "displayName": "Start Date",
      "source": "date",
      "sourceKey": "startDate",
      "defaultValue": "lastSunday"
    },
    {
      "keyName": "endDate",
      "displayName": "End Date",
      "source": "date",
      "sourceKey": "endDate",
      "defaultValue": "today"
    },
    {
      "keyName": "peopleIds",
      "source": "query",
      "sourceKey": "main.personId"
    }
  ],
  "outputs": [
    {
      "outputType": "tree",
      "groupings": [
        1,
        1,
        1
      ],
      "columns": [
        {
          "header": "Session Date",
          "value": "sessionDate",
          "formatter": "string"
        },
        {
          "header": "Service Time",
          "value": "serviceTimeName",
          "formatter": "string"
        },
        {
          "header": "Group",
          "value": "groups.groupName",
          "formatter": "string"
        },
        {
          "header": "Person",
          "value": "people.displayName",
          "formatter": "string"
        },
        {
          "header": "Checked In",
          "value": "checkinTime",
          "formatter": "time"
        },
        {
          "header": "Membership Status",
          "value": "people.membershipStatus",
          "formatter": "string"
        }
      ]
    }
  ],
  "permissions": [
    {
      "requireOne": [
        {
          "api": "AttendanceApi",
          "contentType": "Attendance",
          "action": "View"
        }
      ]
    }
  ]
}