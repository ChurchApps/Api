{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/_migrations",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "noEmitOnError": true
  },
  "include": ["tools/migrations/**/*.ts", "tools/migrate.ts"],
  "exclude": ["node_modules", "dist", "tools/**/*.spec.ts"]
}
